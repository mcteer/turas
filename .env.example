# Names only. Put local values in ignored .env.local. Select the isolated Preview
# app database for runtime and a separate marked disposable database for tests.
AI_GATEWAY_API_KEY=
# Server-only public research search provider. Leave unset to disable live research.
CONTEXT_API_KEY=
# Optional Context.dev naming alias; when set, this takes precedence for rendered reads.
CONTEXT_DEV_API_KEY=
# Set to 1 to disable 005 intake and retrieval worker dispatch during rollback.
TURAS_005_DISABLED=
# Set to 1 to disable new 006 writes and drafting during rollback; eligible historical reads remain.
TURAS_006_DISABLED=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TURAS_ENVIRONMENT_ID=
TURAS_APP_ORIGIN=
TURAS_DEMO_USERNAME=
TURAS_DEMO_PASSWORD=
PANEL_USERNAME=
PANEL_PASSWORD=
PARTNER_USERNAME=
PARTNER_PASSWORD=
TURAS_MAINTENANCE_SECRET=
# Absolute private path outside public; initialize with scripts/prepare-artifacts.ts.
TURAS_ARTIFACT_STORE_ROOT=
# Tests must use a distinct disposable root and environment marker.
TURAS_TEST_ARTIFACT_STORE_ROOT=

# Feature 007: private personnel store prepared explicitly with staffing:prepare.
TURAS_WORKFORCE_STORE_ROOT=
TURAS_007_DISABLED=0
# Optional read-only runtime asset source for disposable staffing checks.
# Only signatures/assets/image attestations are copied, never originals.
TURAS_STAFFING_RUNTIME_ASSET_ROOT=

# Disable new 008 commands/advice; eligible reads, settlement and cleanup remain.
TURAS_008_DISABLED=0

# General technical chat rollout; 1 disables customer-free creation and dispatch.
TURAS_GENERAL_CHAT_DISABLED=0

# 009 reporting: explicit preparation; disabled by default. Never share the upload root.
TURAS_REPORTS_ENABLED=false
# Enable only after lifecycle acceptance and exact operator release approval.
TURAS_REPORT_DELIVERY_ENABLED=false
TURAS_REPORT_STORE_ROOT=
# Pin the reviewed renderer image by sha256 digest.
TURAS_REPORT_RENDERER_IMAGE=
TURAS_REPORT_SENDER_ID=
TURAS_REPORT_SENDER_DOMAIN_ID=
TURAS_REPORT_SENDER_ADDRESS=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# JSON map of key ID to base64 secrets; retain previous keys during rotation.
TURAS_REPORT_RECIPIENT_HMAC_KEYS=
TURAS_REPORT_RECIPIENT_HMAC_KEY_ID=
# Optional 010 receipt-fence HMAC key ring (JSON array, newest first, each >=32 bytes).
# When unset, TURAS_MAINTENANCE_SECRET is used. Before rotating that secret,
# configure this ring with the previous secret and retain every old key until the
# environment is retired; otherwise expired request keys cannot be recognized.
# Never commit actual keys. Existing source-bound fences contain hashes only.
# TURAS_010_RECEIPT_HASH_KEYS=["replace-with-a-private-key-of-at-least-32-bytes"]
# Set to 1 to deny new support writes and generation. Eligible reads, receipts,
# stop, terminal metadata reconciliation and retention remain available.
TURAS_010_DISABLED=0
# Hosted Vercel Cron bearer; independent Production-only secret, >=32 characters.
# Not needed by the local maintenance worker. Never commit a real value.
CRON_SECRET=

# Product expansion: disable new commands/advice; governed cleanup continues.
TURAS_011_DISABLED=0
# Live expansion evaluation requires explicit operator opt-in and a positive USD budget.
# These are evaluation-runner controls, not application defaults.
TURAS_EXPANSION_LIVE_BUDGET_USD=

# 012 product gaps: stop new work and prose release; cancellation and cleanup continue.
TURAS_012_DISABLED=0
# Optional JSON array of private HMAC keys, newest first, each at least32 bytes.
# Retain all previous keys for the environment lifetime to recognize tombstones.
# Unset uses TURAS_MAINTENANCE_SECRET; never commit real key values.
# TURAS_012_RECEIPT_HASH_KEYS=["replace-with-a-private-key-of-at-least-32-bytes"]
# Engineering reports use TURAS_REPORT_STORE_ROOT with explicit gaps:prepare.
# 012 worker preparation/cleanup is independent of TURAS_REPORTS_ENABLED (009).

# Pause new partner enablement work while governed reads/withdrawal/retention continue.
TURAS_013_DISABLED=0

# 014 workspace enablement is operator-controlled DB state; no global bypass flag.
# Optional bounded verified pricing contract; normally fetched from public Gateway metadata.
# TURAS_014_PRICE_CONTRACT=
# Optional private HMAC key ring, newest first; retain old keys for environment lifetime.
# TURAS_014_RECEIPT_HASH_KEYS=["replace-with-a-private-key-of-at-least-32-bytes"]
# Actual learning evaluations require explicit operator budget and opt-in, never CI defaults.
# TURAS_ALLOW_LIVE_MODEL_TESTS=1

# 015 read-only MCP exposure: default disabled; explicit migration 055/grants required.
TURAS_015_DISABLED=1

# 016 pilot backends: explicit selection; credentials never enter processing jobs.
# Keep local until private hosted storage and isolated images are actually verified.
TURAS_PRIVATE_OBJECT_BACKEND=local
TURAS_JOB_EXECUTOR=local
TURAS_PILOT_HOSTED_JOBS_ENABLED=0
# Enable new synthetic-pilot logins only after target isolation and release checks.
# Existing sessions still require their current active workspace membership.
TURAS_PILOT_LOGIN_ENABLED=0
# Exact connected private Blob store identity; Vercel uses fresh project OIDC.
BLOB_STORE_ID=
# Optional protected read-write token for local/operator access.
# Outside Vercel, an explicit protected VERCEL_OIDC_TOKEN is also supported.
BLOB_READ_WRITE_TOKEN=
# Local supervisor sets the current Git commit; hosted uses VERCEL_GIT_COMMIT_SHA.
TURAS_CODE_VERSION=
# Hosted processing images must be immutable, reviewed OCI digests.
TURAS_PILOT_SCANNER_IMAGE=
TURAS_PILOT_PARSER_IMAGE=
TURAS_PILOT_RENDERER_IMAGE=
# Reviewed immutable scanner provenance and sandbox-only reservation configuration.
# JSON metadata contains digests/bounds, never credentials. No implicit budget.
TURAS_PILOT_SCANNER_SIGNATURE_JSON=
TURAS_PILOT_JOB_COST_JSON=
# Optional exact-source synthetic root transport exercise; tools are disabled.
# Keep its existing per-environment budget at or below $2.50. Admit after READY.
TURAS_PILOT_HOSTED_ROOT_BUDGET_JSON=
# Exact original quality-journal binding for owner-admitted hosted evaluation arms.
# Empty keeps ordinary learning unchanged; protected admissions remain fail-closed.
TURAS_PILOT_HOSTED_LEARNING_LEDGER_JSON=
# Explicit operator-only direct Neon verify-full connection; never a runtime env.
TURAS_PILOT_HOSTED_OWNER_DATABASE_URL=
# Exact Sandbox control-plane target; these never enter the execution environment.
# On Vercel, omit VERCEL_TOKEN to use fresh project-bound request OIDC.
# Local/operator commands require an explicit protected control-plane token.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Backup key references are not key bytes; operator supplies keys privately.
TURAS_PILOT_BACKUP_KEY_ID=
TURAS_PILOT_BACKUP_DESTINATION=

# Owned local UI acceptance only: an actual prepared image manifest (no paid provider).
TURAS_PILOT_UI_PREPARATION_FILE=

# Operator-only 016 hosted validation: explicit runtime connection, never a fallback
# to DATABASE_URL or the selected .env.local. Requires Neon sslmode=verify-full.
TURAS_PILOT_HOSTED_DATABASE_URL=
# Operator-only synthetic pilot accounts; never pass these to jobs or commit values.
TURAS_PILOT_HOSTED_ADMIN_PASSWORD=
TURAS_PILOT_HOSTED_MEMBER_PASSWORD=
TURAS_PILOT_HOSTED_PARTNER_PASSWORD=
# Optional deployment-protection bypass for the exact verified hosted origin.
TURAS_PILOT_HOSTED_BYPASS_SECRET=

# Hosted private Blob operations require zero SDK retries after uncertain effects.
VERCEL_BLOB_RETRIES=0
# Optional emergency switch for normal-chat extracted document sends (schema 071).
# TURAS_ORDINARY_ATTACHMENTS_DISABLED=1

# Native ordinary-chat file fallback: schema 072 and verified hosted resource caps required.
# Disabled by default. Do not enable merely because local fixture checks pass.
# TURAS_ORDINARY_NATIVE_FILES_ENABLED=1

# Optional bounded native-file Preview check: both are required together.
# TURAS_ORDINARY_NATIVE_FILES_CONVERSATION_ID=<owned-conversation-uuid>
# TURAS_ORDINARY_NATIVE_FILES_EXPIRES_AT=<ISO-8601-expiry>

# Explicit private-store cutover operator only; keep values outside commits/logs.
# TURAS_STORAGE_ADMIN_COOKIE=
# TURAS_STORAGE_SOURCE_BLOB_TOKEN=
# TURAS_STORAGE_DESTINATION_BLOB_TOKEN=
# TURAS_STORAGE_SOURCE_OIDC_TOKEN=
# TURAS_STORAGE_DESTINATION_OIDC_TOKEN=
