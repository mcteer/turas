# Names only. Put local values in ignored .env.local. Select the isolated Preview
# app database for runtime and a separate marked disposable database for tests.
AI_GATEWAY_API_KEY=
# Server-only public research search provider. Leave unset to disable live research.
CONTEXT_API_KEY=
# Set to 1 to disable 005 intake and retrieval worker dispatch during rollback.
TURAS_005_DISABLED=
# Set to 1 to disable new 006 writes and drafting during rollback; eligible historical reads remain.
TURAS_006_DISABLED=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
TURAS_ENVIRONMENT_ID=
TURAS_APP_ORIGIN=
TURAS_DEMO_USERNAME=
TURAS_DEMO_PASSWORD=
PANEL_USERNAME=
PANEL_PASSWORD=
PARTNER_USERNAME=
PARTNER_PASSWORD=
TURAS_MAINTENANCE_SECRET=
# Absolute private path outside public; initialize with scripts/prepare-artifacts.ts.
TURAS_ARTIFACT_STORE_ROOT=
# Tests must use a distinct disposable root and environment marker.
TURAS_TEST_ARTIFACT_STORE_ROOT=

# Feature 007: private personnel store prepared explicitly with staffing:prepare.
TURAS_WORKFORCE_STORE_ROOT=
TURAS_007_DISABLED=0
# Optional read-only runtime asset source for disposable staffing checks.
# Only signatures/assets/image attestations are copied, never originals.
TURAS_STAFFING_RUNTIME_ASSET_ROOT=
