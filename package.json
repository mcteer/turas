    "learning:ui:check": "node --import tsx scripts/check-learning-ui.ts",
    "learning:recovery:check": "node --import tsx scripts/learning-recovery-check.ts",
    "test:learning:regressions": "node --import tsx scripts/check-learning-regression.ts",
    "benchmark:learning": "node --import tsx scripts/benchmark-learning.ts",
