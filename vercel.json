{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web:check",
  "installCommand": "npm ci && npm ci --prefix packages/artifact-extractor",
  "crons": [
    {
      "path": "/eve/v1/turas/watchdog",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/research-maintenance",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/eve/v1/turas/jobs",
      "schedule": "* * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fix/customer-profiles": false,
      "016-pilot-hardening": false,
      "016-recovery-completion": false
    }
  }
}
